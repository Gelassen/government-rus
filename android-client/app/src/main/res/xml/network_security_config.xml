<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- По умолчанию — только HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Исключение: официальный API Госдумы пока доступен только по HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">api.duma.gov.ru</domain>
        <domain includeSubdomains="true">vote.duma.gov.ru</domain>
    </domain-config>
</network-security-config>
